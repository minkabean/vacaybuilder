{
  "name": "vacaybuilder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate": "wrangler d1 migrations apply vacaybuilder --remote",
    "photos:create": "wrangler r2 bucket create vacaybuilder-photos || true",
    "provision": "npm run photos:create && npm run db:migrate",
    "deploy": "npm run provision && wrangler deploy"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}